classDiagram
    class Owner {
        +name: str
        +available_start: str
        +available_end: str
        +preferences: list[str]
        +add_pet(pet: Pet)
        +update_preferences()
    }

    class Pet {
        +name: str
        +species: str
        +age: int
        +notes: str
        +add_task(task: Task)
        +get_tasks() list[Task]
    }

    class Task {
        +title: str
        +category: str
        +duration_minutes: int
        +priority: Priority
        +is_recurring: bool
        +get_priority_score() int
    }

    class Priority {
        <<enumeration>>
        low
        medium
        high
    }

    class TimeBlock {
        +start_time: str
        +end_time: str
        +task: Task
        +is_available() bool
    }

    class Schedule {
        +date: str
        +time_blocks: list[TimeBlock]
        +add_task(task: Task, start_time: str)
        +summarize() str
    }

    class Scheduler {
        +build_daily_plan(owner: Owner, pet: Pet, tasks: list[Task]) Schedule
        +sort_tasks(tasks: list[Task]) list[Task]
        +filter_by_time(tasks: list[Task], available_minutes: int) list[Task]
        +resolve_conflicts(schedule: Schedule) Schedule
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : needs
    Task --> Priority : has
    Schedule "1" --> "1..*" TimeBlock : contains
    Scheduler ..> Schedule : creates
    Scheduler ..> Task : evaluates

    note for Owner "Stores owner details, availability, and preferences"
    note for Pet "Represents the pet and the care tasks associated with it"
    note for Task "Represents one care activity with duration and priority"
    note for Scheduler "Chooses and orders tasks into a daily plan"
